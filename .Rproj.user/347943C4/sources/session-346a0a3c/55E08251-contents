/* Global style */
body {
  font-family: "Helvetica Neue", Arial, sans-serif;
  background: linear-gradient(135deg, #f8f9fa, #e9f5ec);
}

/* Headings */
h1, h2, h3 {
  color: #1b4332;
}

/* Make titles consistent */
h1 {
  font-size: 2.8rem;
  font-weight: 700;
  text-align: center;
}

h2 {
  font-size: 1.6rem;
  border-bottom: 2px solid #95d5b2;
  padding-bottom: 5px;
}

/* Navbar */
.navbar {
  background: linear-gradient(90deg, #1b4332, #2d6a4f) !important;
  box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

.navbar a {
  color: white !important;
  font-weight: 600;
  transition: 0.3s;
}

.navbar a:hover {
  color: #d8f3dc !important;
  transform: scale(1.1);
}

/* Cards (important for ALL pages) */
.callout-note {
  border: none;
  background: white;
  border-radius: 15px;
  padding: 20px;
  margin-bottom: 25px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}

/* Fix spacing between sections */
p {
  line-height: 1.6;
}

/* Images */
img {
  border-radius: 50%;
  border: 4px solid #95d5b2;
  box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}

/* Page width */
.container {
  max-width: 900px;
}

/* Links */
a {
  color: #2d6a4f;
}

a:hover {
  color: #1b4332;
}